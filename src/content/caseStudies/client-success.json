  "bodyHtml": "<div class=\"page-wrap\" id=\"content\">\n<!-- Page Hero -->\n<div class=\"page-hero\" style=\"background-image: url('/images/slider/slide1-home1.webp');\">\n<div class=\"container\">\n<nav aria-label=\"Breadcrumb\" class=\"breadcrumb-nav\">\n<a href=\"/\">Home</a>\n<span class=\"separator\">/</span>\n<span class=\"current\">Client Success</span>\n</nav>\n<h1>Measurable Outcomes.<br/>Every Engagement.</h1>\n<p style=\"color: rgba(255,255,255,0.75); font-size: 17px; max-width: 600px; margin-top: 15px;\">\n            We partner with organizations to solve complex technology challenges and deliver systems that produce measurable business results.\n          </p>\n</div>\n</div>\n<!-- Impact Metrics Bar -->\n<section class=\"metrics-bar\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-md-3 col-6\">\n<div class=\"metric-item\">\n<div class=\"metric-number\">8+</div>\n<div class=\"metric-label\">Projects Shipped</div>\n</div>\n</div>\n<div class=\"col-md-3 col-6\">\n<div class=\"metric-item\">\n<div class=\"metric-number\">4</div>\n<div class=\"metric-label\">Industries Served</div>\n</div>\n</div>\n<div class=\"col-md-3 col-6\">\n<div class=\"metric-item\">\n<div class=\"metric-number\">100%</div>\n<div class=\"metric-label\">On-Time Delivery</div>\n</div>\n</div>\n<div class=\"col-md-3 col-6\">\n<div class=\"metric-item\">\n<div class=\"metric-number\">3</div>\n<div class=\"metric-label\">Countries</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Client Engagements Section -->\n<section class=\"section-padd\">\n<div class=\"container\">\n<div class=\"ot-heading text-center mb-5\">\n<span>// client engagements</span>\n<h2 class=\"main-heading\">Client Projects</h2>\n<p style=\"max-width: 650px; margin: 15px auto 0; color: #6d6d6d;\">\n              Real solutions delivered for organizations across education, community, healthcare, and commerce  -  each built to scale, secure, and perform.\n            </p>\n</div>\n<div class=\"case-study-grid\">\n<!-- Bada Language Institute -->\n<div class=\"case-study-card\">\n<div class=\"card-image-wrap\">\n<img alt=\"Bada Language Institute LMS Platform\" height=\"520\" loading=\"lazy\" src=\"/images/projects/project7-720x520.webp\" width=\"720\"/>\n</div>\n<div class=\"card-body\">\n<div class=\"card-tag\">Education / LMS</div>\n<h3 class=\"card-title\">Bada Language Institute</h3>\n<p class=\"card-text\">\n                  Full-stack student management LMS with event scheduling, enrolment workflows, and regional content delivery for a language education provider.\n                </p>\n<div class=\"card-footer\">\n<a class=\"card-btn\" href=\"/portfolio/case-study-bada\">View Case Study <i class=\"fas fa-arrow-right\"></i></a>\n<div class=\"metric-badge-wrap\">\n<span class=\"metric-value\">100%</span>\n<span class=\"metric-desc\">Digital Enrolment</span>\n</div>\n</div>\n</div>\n</div>\n<!-- SGSS Mombasa -->\n<div class=\"case-study-card\">\n<div class=\"card-image-wrap\">\n<img alt=\"SGSS Mombasa Medical Fund Portal\" height=\"520\" loading=\"lazy\" src=\"/images/projects/project3-720x520.webp\" width=\"720\"/>\n</div>\n<div class=\"card-body\">\n<div class=\"card-tag\">Healthcare / Community</div>\n<h3 class=\"card-title\">SGSS Mombasa Medical Fund</h3>\n<p class=\"card-text\">\n                  Secure medical fund management portal with donor tracking, patient records security, and real-time reporting for a community healthcare organization.\n                </p>\n<div class=\"card-footer\">\n<a class=\"card-btn\" href=\"/portfolio/case-study-sgss\">View Case Study <i class=\"fas fa-arrow-right\"></i></a>\n<div class=\"metric-badge-wrap\">\n<span class=\"metric-value\">Secured</span>\n<span class=\"metric-desc\">Patient Records</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Rotaract Nyali -->\n<div class=\"case-study-card\">\n<div class=\"card-image-wrap\">\n<img alt=\"Rotaract Club of Nyali Community Portal\" height=\"520\" loading=\"lazy\" src=\"/images/projects/project-720x520.webp\" width=\"720\"/>\n</div>\n<div class=\"card-body\">\n<div class=\"card-tag\">NGO / Community</div>\n<h3 class=\"card-title\">Rotaract Club Nyali</h3>\n<p class=\"card-text\">\n                  Community engagement portal with membership management, event registration, and project tracking for a Rotary-affiliated community service organization.\n                </p>\n<div class=\"card-footer\">\n<a class=\"card-btn\" href=\"/portfolio/case-study-racnyali\">View Case Study <i class=\"fas fa-arrow-right\"></i></a>\n<div class=\"metric-badge-wrap\">\n<span class=\"metric-value\">Streamlined</span>\n<span class=\"metric-desc\">Member Ops</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Internal Engineering Projects Section -->\n<section class=\"section-padd bg-dark-primary\">\n<div class=\"container\">\n<div class=\"ot-heading text-center mb-5\">\n<span class=\"text-primary-light\">// internal engineering</span>\n<h2 class=\"main-heading text-white\">Engineering Benchmarks</h2>\n<p style=\"max-width: 650px; margin: 15px auto 0; color: rgba(255,255,255,0.6);\">\n              Proof-of-concept builds and engineering showcases that demonstrate our full-stack development capabilities across diverse technology platforms.\n            </p>\n</div>\n<div class=\"case-study-grid\">\n<!-- Crappo -->\n<div class=\"case-study-card\">\n<div class=\"card-image-wrap\">\n<img alt=\"Crappo Crypto Investment Platform\" height=\"520\" loading=\"lazy\" src=\"/images/projects/project4-720x520.webp\" width=\"720\"/>\n</div>\n<div class=\"card-body\">\n<div class=\"card-tag\">FinTech / Crypto</div>\n<h3 class=\"card-title\">Crappo Crypto Platform</h3>\n<p class=\"card-text\">\n                  Modern cryptocurrency investment platform featuring live market data integration, secure wallet connections, and sleek dark-mode UI components.\n                </p>\n<div class=\"card-footer\">\n<a class=\"card-btn\" href=\"/portfolio/case-study-crappo\">View Case Study <i class=\"fas fa-arrow-right\"></i></a>\n<div class=\"metric-badge-wrap\">\n<span class=\"metric-desc\">Internal Project</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Audiophile -->\n<div class=\"case-study-card\">\n<div class=\"card-image-wrap\">\n<img alt=\"Audiophile E-Commerce Platform\" height=\"520\" loading=\"lazy\" src=\"/images/projects/project8-720x520.webp\" width=\"720\"/>\n</div>\n<div class=\"card-body\">\n<div class=\"card-tag\">Retail / E-Commerce</div>\n<h3 class=\"card-title\">Audiophile E-Commerce</h3>\n<p class=\"card-text\">\n                  Premium audio equipment e-commerce platform with multi-step checkout, product filtering, responsive image galleries, and cart persistence.\n                </p>\n<div class=\"card-footer\">\n<a class=\"card-btn\" href=\"/portfolio/case-study-audiophile\">View Case Study <i class=\"fas fa-arrow-right\"></i></a>\n<div class=\"metric-badge-wrap\">\n<span class=\"metric-desc\">Internal Project</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Green Remedies -->\n<div class=\"case-study-card\">\n<div class=\"card-image-wrap\">\n<img alt=\"Green Remedies Herbal E-Commerce\" height=\"520\" loading=\"lazy\" src=\"/images/projects/project7-720x520.webp\" width=\"720\"/>\n</div>\n<div class=\"card-body\">\n<div class=\"card-tag\">E-Commerce / Open Source</div>\n<h3 class=\"card-title\">Green Remedies</h3>\n<p class=\"card-text\">\n                  Open-source team project  -  a fully authenticated e-commerce application for herbal products with Kinde Auth, secure checkout, and real-time inventory.\n                </p>\n<div class=\"card-footer\">\n<a class=\"card-btn\" href=\"/portfolio/case-study-greenremedies\">View Case Study <i class=\"fas fa-arrow-right\"></i></a>\n<div class=\"metric-badge-wrap\">\n<span class=\"metric-desc\">Open Source</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Transit Flow -->\n<div class=\"case-study-card\">\n<div class=\"card-image-wrap\">\n<img alt=\"Transit Flow Logistics Landing Page\" height=\"520\" loading=\"lazy\" src=\"/images/projects/project3-720x520.webp\" width=\"720\"/>\n</div>\n<div class=\"card-body\">\n<div class=\"card-tag\">Logistics / Landing Page</div>\n<h3 class=\"card-title\">Transit Flow Logistics</h3>\n<p class=\"card-text\">\n                  High-performance, fully responsive business landing page for a modern logistics provider. Designed in Figma and converted to production-quality React components.\n                </p>\n<div class=\"card-footer\">\n<a class=\"card-btn\" href=\"/portfolio/case-study-transitflow\">View Case Study <i class=\"fas fa-arrow-right\"></i></a>\n<div class=\"metric-badge-wrap\">\n<span class=\"metric-desc\">Internal Project</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- CTA Section -->\n<section class=\"section-padd\">\n<div class=\"container\">\n<div class=\"cta\">\n<div class=\"row\">\n<div class=\"col-md-8 text-md-left text-center mb-4 mb-md-0\">\n<div class=\"ot-heading\">\n<span>// your challenge, our expertise</span>\n<h2 class=\"main-heading\">Your business challenge could be our next success story.</h2>\n</div>\n</div>\n<div class=\"col-md-4 text-md-right text-center align-self-end\">\n<a class=\"octf-btn octf-btn-primary\" href=\"/book-consultation\">Book Advisory Session</a>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>",
