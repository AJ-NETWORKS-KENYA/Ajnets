  "bodyHtml": "<div class=\"site-content\" id=\"content\">\n<div class=\"page-header flex-middle\">\n<div class=\"container\">\n<div class=\"inner flex-middle\">\n<h1 class=\"page-title\">Request a Strategy Call</h1>\n<ul class=\"breadcrumbs none-style\" id=\"breadcrumbs\">\n<li><a href=\"./\">Home</a></li>\n<li class=\"active\">Contact</li>\n</ul>\n</div>\n</div>\n</div>\n<section class=\"contact-page\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-6\">\n<div class=\"contact-left\">\n<div class=\"ot-heading\">\n<span>// let's talk strategy</span>\n<h2 class=\"main-heading\">Get in Touch</h2>\n</div>\n<div class=\"space-5\"></div>\n<p>\n                    We work with organizations facing complex technology\n                    challenges. Whether you need strategic guidance or\n                    engineering delivery, let's discuss how we can help.\n                  </p>\n<div class=\"contact-info box-style1\">\n<i class=\"flaticon-world-globe\"></i>\n<div class=\"info-text\">\n<h6>Our Location:</h6>\n<p>\n                        Kenya (HQ): Nairobi &amp; Mombasa<br/>Rwanda: Regional\n                        Operations\n                      </p>\n</div>\n</div>\n<div class=\"contact-info box-style1\">\n<i class=\"flaticon-envelope\"></i>\n<div class=\"info-text\">\n<h6>Our Email:</h6>\n<p>hello@ajnetworks.co</p>\n</div>\n</div>\n<div class=\"contact-info box-style1\">\n<i class=\"flaticon-phone-1\"></i>\n<div class=\"info-text\">\n<h6>Our Phone:</h6>\n<p>+254 758 238 617</p>\n</div>\n</div>\n<div class=\"contact-info box-style1\">\n<i class=\"flaticon-clock\"></i>\n<div class=\"info-text\">\n<h6>Working Hours:</h6>\n<p>\n                        Monday - Friday: 8:00 AM  -  5:00 PM (EAT)<br/>Saturday: By\n                        appointment only\n                      </p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6\">\n<form action=\"/api/contact\" class=\"wpcf7\" id=\"ajax-form\" method=\"post\" name=\"ajax-form\" novalidate=\"\">\n<input type=\"text\" name=\"bot_field\" id=\"bot_field\" style=\"display:none !important; visibility:hidden !important; position:absolute; left:-9999px;\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\" />\n<div class=\"main-form\">\n<h2>Request a Strategy Call</h2>\n<p class=\"font14\">\n                      Share your technology challenge and we'll schedule a\n                      consultation to discuss how we can help.\n                    </p>\n<p>\n<label for=\"name\">\n<span class=\"error\" id=\"err-name\">please enter name</span></label>\n<input aria-invalid=\"false\" aria-required=\"true\" class=\"\" id=\"name\" name=\"name\" placeholder=\"Your Name *\" required=\"\" size=\"40\" type=\"text\" value=\"\"/>\n</p>\n<p>\n<label for=\"organization\">\n<span class=\"error\" id=\"err-organization\">please enter organization</span></label>\n<input aria-invalid=\"false\" aria-required=\"true\" class=\"\" id=\"organization\" name=\"organization\" placeholder=\"Your Organization *\" required=\"\" size=\"40\" type=\"text\" value=\"\"/>\n</p>\n<p>\n<label for=\"region\">\n<span class=\"error\" id=\"err-region\">please select your region</span></label>\n<select aria-invalid=\"false\" aria-required=\"true\" class=\"wpcf7-form-control\" id=\"region\" name=\"region\" required=\"\">\n<option disabled=\"\" selected=\"\" value=\"\">\n                          Select Your Region *\n                        </option>\n<option value=\"Kenya\">Kenya (Nairobi / Mombasa / Other)</option>\n<option value=\"Rwanda\">Rwanda (Kigali / Other)</option>\n<option value=\"Uganda\">Uganda (Kampala / Other)</option>\n<option value=\"East Africa\">Other East Africa (Tanzania, etc.)</option>\n<option value=\"International\">International / Other</option>\n</select>\n</p>\n<p>\n<label for=\"email\">\n<span class=\"error\" id=\"err-email\">please enter e-mail</span>\n<span class=\"error\" id=\"err-emailvld\">e-mail is not a valid format</span>\n</label>\n<input aria-invalid=\"false\" aria-required=\"true\" class=\"\" id=\"email\" name=\"email\" placeholder=\"Your Email *\" required=\"\" size=\"40\" type=\"email\" value=\"\"/>\n</p>\n<p>\n<label for=\"phone\">\n<span class=\"error\" id=\"err-phone\">please enter phone number</span>\n</label>\n<input aria-invalid=\"false\" aria-required=\"true\" class=\"\" id=\"phone\" name=\"phone\" placeholder=\"Your Phone Number *\" required=\"\" size=\"40\" type=\"tel\" value=\"\"/>\n</p>\n<p>\n<label for=\"message\"></label>\n<textarea aria-invalid=\"false\" class=\"\" cols=\"40\" id=\"message\" name=\"message\" placeholder=\"Describe your technology challenge or strategic need.\" required=\"\" rows=\"10\"></textarea>\n</p>\n<p>\n<button class=\"octf-btn octf-btn-primary\" id=\"send\" type=\"submit\">\n                        Request Strategy Call\n                      </button>\n</p>\n<div class=\"clear\"></div>\n<div class=\"error\" id=\"err-form\">\n                      There was a problem validating the form please check!\n                    </div>\n<div class=\"error\" id=\"err-timedout\">\n                      The connection to the server timed out!\n                    </div>\n<div class=\"error\" id=\"err-state\"></div>\n</div>\n</form>\n<div class=\"clear\"></div>\n<div id=\"ajaxsuccess\">Successfully sent!!</div>\n<div class=\"clear\"></div>\n<!-- Success Modal -->\n<div class=\"modal modal-overlay\" id=\"successModal\">\n<div class=\"modal-content\">\n<span class=\"close-modal\">×</span>\n<div class=\"modal-success-icon\">\n<i class=\"fas fa-check-circle\"></i>\n</div>\n<h2>Thank You!</h2>\n<p>\n                      Your strategy call request has been successfully\n                      submitted. Our team will get back to you shortly.\n                    </p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<div class=\"no-padding\">\n<div class=\"map\">\n<iframe allowfullscreen=\"\" aria-hidden=\"false\" height=\"500\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d255345.0955081649!2d36.70730744863279!3d-1.302113199999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x182f1172d84d49a7%3A0xf7cf0254b297924c!2sNairobi%2C%20Kenya!5e0!3m2!1sen!2s!4v1641234567890!5m2!1sen!2s\" style=\"border: 0\" tabindex=\"0\" title=\"AJNETWORKS Location - Nairobi, Kenya\"></iframe>\n</div>\n</div>\n</div>",
