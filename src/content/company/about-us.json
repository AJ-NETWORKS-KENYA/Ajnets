  "bodyHtml": "<div class=\"site-content\" id=\"content\">\n<div class=\"page-header flex-middle\">\n<div class=\"container\">\n<div class=\"inner flex-middle\">\n<h1 class=\"page-title\">About Us</h1>\n<ul class=\"breadcrumbs none-style\" id=\"breadcrumbs\">\n<li><a href=\"/\">Home</a></li>\n<li class=\"active\">About Us</li>\n</ul>\n</div>\n</div>\n</div>\n<section class=\"about-offer\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-6 align-self-center mb-30 mb-lg-0\">\n<div class=\"ot-heading\">\n<span>// who we are</span>\n<h2 class=\"main-heading\">\n                    A Technology Consulting Partner <br/>Focused on Execution\n                  </h2>\n</div>\n<div class=\"space-5\"></div>\n<p>\n                  AJNETWORKS is a technology consulting firm that helps\n                  organisations make confident technology decisions and\n                  build secure, scalable digital systems. We work across\n                  East Africa and beyond, partnering with businesses that\n                  need strategic clarity before they write a single line of code.\n                </p>\n<p>\n<em class=\"text-dark\"><strong>We lead with business outcomes, strategy, and advisory,\n                      then execute through strong in-house engineering,\n                      networking, and cybersecurity capabilities.</strong></em>\n</p>\n<div class=\"space-20\"></div>\n</div>\n<div class=\"col-lg-6\">\n<div class=\"row\">\n<div class=\"col-lg-6 col-md-6 mb-4\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Mission</h5>\n<p>\n                              To help organizations make confident technology\n                              decisions and deliver secure, scalable digital\n                              systems that create measurable business impact.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Mission</h3>\n<img alt=\"Our Mission\" loading=\"lazy\" src=\"/images/image-box1.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6 col-md-6 mb-4\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Vision</h5>\n<p>\n                              To be a trusted technology consulting partner\n                              across Africa and globally, recognized for\n                              strategic clarity, engineering excellence, and\n                              security-first delivery.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Vision</h3>\n<img alt=\"Our Vision\" loading=\"lazy\" src=\"/images/image-box2.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6 col-md-6 mb-4 mb-md-0\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Philosophy</h5>\n<p>\n                              We believe technology should solve real business\n                              problems. Every solution must be intentional,\n                              secure by design, and built to scale  -  not just to\n                              launch.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Philosophy</h3>\n<img alt=\"Our Philosophy\" loading=\"lazy\" src=\"/images/image-box3.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6 col-md-6\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Strategy</h5>\n<p>\n                              We lead with consulting and insight, execute\n                              through disciplined engineering, and embed\n                              cybersecurity and networking at every stage to\n                              ensure long-term resilience.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Strategy</h3>\n<img alt=\"Our Strategy\" loading=\"lazy\" src=\"/images/image-box4.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"trust-strip\">\n<div class=\"container\">\n<span class=\"trust-strip-title\">Trusted by Leading Organizations &amp; Enterprise Partners</span>\n<div class=\"trust-logos\">\n<a aria-label=\"Rotaract Club of Nyali\" class=\"trust-logo-item\" href=\"https://rotaractnyali.org/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Rotaract Club of Nyali\" class=\"logo-wide\" height=\"44\" src=\"/images/client-logos/rotaract-nyali.webp\" width=\"160\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"Bada Language Institute\" class=\"trust-logo-item\" href=\"https://www.badaglobal-bli.com/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Bada Language Institute\" height=\"44\" src=\"/images/client-logos/bli-global.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"Siri Guru Singh Sabha Mombasa\" class=\"trust-logo-item\" href=\"https://www.sgssmombasa.org/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Siri Guru Singh Sabha Mombasa\" class=\"logo-tall\" height=\"48\" src=\"/images/client-logos/sgss-mombasa.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"SGSS Mombasa Medical Fund\" class=\"trust-logo-item\" href=\"https://medical.sgssmombasa.org/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"SGSS Medical Fund\" class=\"logo-tall\" height=\"48\" src=\"/images/client-logos/sgss-medical-fund.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"Visa Portal Solutions\" class=\"trust-logo-item\" href=\"https://visaportal.co.ke\">\n<img alt=\"Visa Portal Solutions\" height=\"44\" src=\"/images/client-logos/visa-portal-solutions.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n</div>\n</div>\n</section>\n<section class=\"about-v5\">\n<div class=\"overlay overlay-image-about5\"></div>\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-6 align-self-center\">\n<div class=\"pabout-left\">\n<img alt=\"AJNETWORKS Enterprise Engineering &amp; Advisory\" loading=\"lazy\" src=\"/images/image1-about.webp\" width=\"665\" height=\"493\"/>\n</div>\n</div>\n<div class=\"col-lg-6\">\n<div class=\"pabout-right\">\n<div class=\"ot-heading\">\n<span>// Experience. Execution. Excellence.</span>\n<h2 class=\"main-heading\">What We Actually Do</h2>\n</div>\n<div class=\"tech-wrap\">\n<a class=\"tech-box\" href=\"/services/technology-strategy\" title=\"Technology Strategy &amp; Advisory\"><div class=\"icon-main\">\n<span class=\"flaticon-tablet\"></span>\n</div>\n</a>\n<a class=\"tech-box\" href=\"/services/software-engineering\" title=\"Software Engineering\"><div class=\"icon-main\">\n<span class=\"flaticon-code\"></span>\n</div>\n</a>\n<a class=\"tech-box\" href=\"/services/cybersecurity\" title=\"Cybersecurity &amp; Assurance\"><div class=\"icon-main\">\n<span class=\"flaticon-shield\"></span>\n</div>\n</a>\n<a class=\"tech-box\" href=\"/services/networking\" title=\"Cloud &amp; Network Infrastructure\"><div class=\"icon-main\">\n<span class=\"flaticon-gear\"></span>\n</div>\n</a>\n</div>\n<h5>Integrated Consulting &amp; Engineering Delivery</h5>\n<p>\n                    AJNETWORKS delivers end-to-end technology solutions from\n                    strategy to execution. We specialize in custom software\n                    development, cloud-native architecture, cybersecurity,\n                    networking infrastructure, and performance optimization. Our\n                    team combines deep technical expertise with business acumen\n                    to drive real results.\n                  </p>\n<div class=\"ot-button\">\n<a class=\"btn-details\" href=\"/services\" title=\"Explore Services\"><i class=\"flaticon-right-arrow-1\"></i> EXPLORE OUR CAPABILITIES</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"about-team\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-12 text-center\">\n<div class=\"ot-heading\">\n<span>// our leadership</span>\n<h2 class=\"main-heading\">Leadership &amp; Technical Stewardship</h2>\n</div>\n<div class=\"space-5\"></div>\n<p>\n                  Every AJNETWORKS engagement is led directly by senior technical\n                  leadership<br/>\n                  combining strategic advisory experience with hands-on systems\n                  architecture.\n                </p>\n<div class=\"space-20\"></div>\n</div>\n</div>\n<div class=\"row no-margin\">\n<div class=\"col-12 d-flex justify-content-center mb-4\">\n<div class=\"team-wrap v3\" style=\"max-width: 360px; width: 100%;\">\n<div class=\"team-thumb text-center\">\n<img alt=\"Abraham John — Founder, CEO &amp; Principal Consultant\" class=\"img-fluid rounded-circle\" loading=\"lazy\" src=\"/images/Member1.webp\" width=\"240\" height=\"240\" style=\"width: 240px; height: 240px; object-fit: cover; object-position: top center; border-radius: 50%; margin: 0 auto;\"/>\n<div class=\"team-social flex-middle\">\n<div>\n<a class=\"twitter\" href=\"https://X.com/jabrahamjohns\" rel=\"nofollow noopener\" target=\"_blank\" title=\"X (Twitter)\"><i class=\"fab fa-twitter\"></i></a>\n<a class=\"linkedin\" href=\"https://linkedin.com/in/jabrahamjohns\" rel=\"nofollow noopener\" target=\"_blank\" title=\"LinkedIn\"><i class=\"fab fa-linkedin-in\"></i></a>\n<a class=\"pinterest\" href=\"https://pinterest.com/jabrahamjohns\" rel=\"nofollow noopener\" target=\"_blank\" title=\"Pinterest\"><i class=\"fab fa-pinterest-p\"></i></a>\n<a class=\"instagram\" href=\"https://instagram.com/jabrahamjohns\" rel=\"nofollow noopener\" target=\"_blank\" title=\"Instagram\"><i class=\"fab fa-instagram\"></i></a>\n</div>\n</div>\n</div>\n<div class=\"team-info text-center\">\n<h4>Abraham John</h4>\n<span>Founder, CEO &amp; Principal Consultant</span>\n<div style=\"margin-top: 12px;\">\n<a href=\"mailto:abrahamjohn@ajnetworks.co\" style=\"font-size: 14px; font-weight: 600; color: #00a3ff;\">Direct contact with the founder &rarr;</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"about-counter\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-12\">\n<div class=\"s-counter4\">\n<div class=\"row\">\n<div class=\"col-lg-3 col-md-6 col-sm-6 text-center mb-4 mb-lg-0\">\n<div class=\"ot-counter text-white\">\n<div>\n<span class=\"num\" data-time=\"1500\" data-to=\"20\">20</span>\n<span>+</span>\n</div>\n<h6 class=\"text-white\">Production Systems Delivered</h6>\n</div>\n</div>\n<div class=\"col-lg-3 col-md-6 col-sm-6 text-center mb-4 mb-lg-0\">\n<div class=\"ot-counter text-white\">\n<div>\n<span class=\"num\" data-time=\"1500\" data-to=\"5\">5</span>\n<span></span>\n</div>\n<h6 class=\"text-white\">Core Practice Pillars</h6>\n</div>\n</div>\n<div class=\"col-lg-3 col-md-6 col-sm-6 text-center mb-4 mb-sm-0\">\n<div class=\"ot-counter text-white\">\n<div>\n<span class=\"num\" data-time=\"1500\" data-to=\"2\">2</span>\n<span></span>\n</div>\n<h6 class=\"text-white\">East African Hubs (KE &amp; RW)</h6>\n</div>\n</div>\n<div class=\"col-lg-3 col-md-6 col-sm-6 text-center\">\n<div class=\"ot-counter text-white\">\n<div>\n<span class=\"num\" data-time=\"1500\" data-to=\"100\">100</span>\n<span>%</span>\n</div>\n<h6 class=\"text-white\">Security-First Delivery</h6>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"space-105\"></div>\n<div class=\"row\">\n<div class=\"col-lg-6 align-self-center\">\n<div class=\"technology-v3-left\">\n<div class=\"ot-heading\">\n<span>// execution standards</span>\n<h2 class=\"main-heading\">\n                      Architectural Rigor &amp; Engineering Discipline\n                    </h2>\n</div>\n<div class=\"space-5\"></div>\n<p>\n                    We partner directly with executive leadership and operational teams across Kenya, Rwanda, and East Africa to architect, build, and harden mission-critical digital infrastructure.\n                  </p>\n<div class=\"space-10\"></div>\n<div class=\"et-progress\">\n<div class=\"ot-progress\">\n<div class=\"overflow\">\n<span class=\"pname f-left\">Strategic Technology Advisory</span>\n<span class=\"ppercent f-right\">100%</span>\n</div>\n<div class=\"iprogress\">\n<div class=\"progress-bar\" data-percent=\"100%\" style=\"width: 100%;\"></div>\n</div>\n</div>\n<div class=\"ot-progress\">\n<div class=\"overflow\">\n<span class=\"pname f-left\">Custom Software &amp; Cloud Engineering</span>\n<span class=\"ppercent f-right\">100%</span>\n</div>\n<div class=\"iprogress\">\n<div class=\"progress-bar\" data-percent=\"100%\" style=\"width: 100%;\"></div>\n</div>\n</div>\n<div class=\"ot-progress\">\n<div class=\"overflow\">\n<span class=\"pname f-left\">Cybersecurity &amp; Network Assurance</span>\n<span class=\"ppercent f-right\">100%</span>\n</div>\n<div class=\"iprogress\">\n<div class=\"progress-bar\" data-percent=\"100%\" style=\"width: 100%;\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6 align-self-center\">\n<img alt=\"AJNETWORKS Engineering Delivery Standards\" loading=\"lazy\" src=\"/images/image2-about.webp\" width=\"535\" height=\"455\"/>\n</div>\n</div>\n</div>\n</section>\n</div>",
