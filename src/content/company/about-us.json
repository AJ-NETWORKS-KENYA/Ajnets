  "bodyHtml": "<div class=\"site-content\" id=\"content\">\n<div class=\"page-header flex-middle\">\n<div class=\"container\">\n<div class=\"inner flex-middle\">\n<h1 class=\"page-title\">About Us</h1>\n<ul class=\"breadcrumbs none-style\" id=\"breadcrumbs\">\n<li><a href=\"./\">Home</a></li>\n<li class=\"active\">About Us</li>\n</ul>\n</div>\n</div>\n</div>\n<section class=\"about-offer\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-6 align-self-center mb-30 mb-lg-0\">\n<div class=\"ot-heading\">\n<span>// who we are</span>\n<h2 class=\"main-heading\">\n                    A Technology Consulting Partner <br/>Focused on Execution\n                  </h2>\n</div>\n<div class=\"space-5\"></div>\n<p>\n                  AJNETWORKS is a technology consulting firm that helps\n                  organisations make confident technology decisions and\n                  build secure, scalable digital systems. We work across\n                  East Africa and beyond, partnering with businesses that\n                  need strategic clarity before they write a single line of code.\n                </p>\n<p>\n<em class=\"text-dark\"><strong>We lead with business outcomes, strategy, and advisory,\n                      then execute through strong in-house engineering,\n                      networking, and cybersecurity capabilities.</strong></em>\n</p>\n<div class=\"space-20\"></div>\n\n<div class=\"col-lg-6\">\n<div class=\"row\">\n<div class=\"col-lg-6 col-md-6 mb-4\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Mission</h5>\n<p>\n                              To help organizations make confident technology\n                              decisions and deliver secure, scalable digital\n                              systems that create measurable business impact.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Mission</h3>\n<img alt=\"Our Mission\" loading=\"lazy\" src=\"/images/image-box1.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6 col-md-6 mb-4\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Vision</h5>\n<p>\n                              To be a trusted technology consulting partner\n                              across Africa and globally, recognized for\n                              strategic clarity, engineering excellence, and\n                              security-first delivery.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Vision</h3>\n<img alt=\"Our Vision\" loading=\"lazy\" src=\"/images/image-box2.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6 col-md-6 mb-4 mb-md-0\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Philosophy</h5>\n<p>\n                              We believe technology should solve real business\n                              problems. Every solution must be intentional,\n                              secure by design, and built to scale  -  not just to\n                              launch.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Philosophy</h3>\n<img alt=\"Our Philosophy\" loading=\"lazy\" src=\"/images/image-box3.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"col-lg-6 col-md-6\">\n<div class=\"support-box\">\n<div class=\"inner-box\">\n<div class=\"overlay flex-middle\">\n<div class=\"inner\">\n<h5>Our Strategy</h5>\n<p>\n                              We lead with consulting and insight, execute\n                              through disciplined engineering, and embed\n                              cybersecurity and networking at every stage to\n                              ensure long-term resilience.\n                            </p>\n</div>\n</div>\n<div class=\"content-box\">\n<h3>Our Strategy</h3>\n<img alt=\"Our Strategy\" loading=\"lazy\" src=\"/images/image-box4.webp\" width=\"730\" height=\"730\"/>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"trust-strip\">\n<div class=\"container\">\n<span class=\"trust-strip-title\">Trusted by Leading Organizations &amp; Enterprise Partners</span>\n<div class=\"trust-logos\">\n<a aria-label=\"Rotaract Club of Nyali\" class=\"trust-logo-item\" href=\"https://rotaractnyali.org/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Rotaract Club of Nyali\" class=\"logo-wide\" height=\"44\" src=\"/images/client-logos/rotaract-nyali.webp\" width=\"160\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"Bada Language Institute\" class=\"trust-logo-item\" href=\"https://www.badaglobal-bli.com/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Bada Language Institute\" height=\"44\" src=\"/images/client-logos/bli-global.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"Siri Guru Singh Sabha Mombasa\" class=\"trust-logo-item\" href=\"https://www.sgssmombasa.org/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"Siri Guru Singh Sabha Mombasa\" class=\"logo-tall\" height=\"48\" src=\"/images/client-logos/sgss-mombasa.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"SGSS Mombasa Medical Fund\" class=\"trust-logo-item\" href=\"https://medical.sgssmombasa.org/\" rel=\"noopener\" target=\"_blank\">\n<img alt=\"SGSS Medical Fund\" class=\"logo-tall\" height=\"48\" src=\"/images/client-logos/sgss-medical-fund.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n<a aria-label=\"Visa Portal Solutions\" class=\"trust-logo-item\" href=\"https://visaportal.co.ke\">\n<img alt=\"Visa Portal Solutions\" height=\"44\" src=\"/images/client-logos/visa-portal-solutions.webp\" width=\"140\" fetchpriority=\"high\"/>\n</a>\n</div>\n</div>\n</section>\n<section class=\"about-v5\">\n<div class=\"overlay overlay-image-about5\"></div>\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-6 align-self-center\">\n<div class=\"pabout-left\">\n<img alt=\"AJNETWORKS Image1 About\" loading=\"lazy\" src=\"/images/image1-about.webp\" width=\"665\" height=\"493\"/>\n</div>\n</div>\n<div class=\"col-lg-6\">\n<div class=\"pabout-right\">\n<div class=\"ot-heading\">\n<span>// Experience. Execution. Excellence.</span>\n<h2 class=\"main-heading\">What We Actually Do</h2>\n</div>\n<div class=\"tech-wrap\">\n<a class=\"tech-box\" href=\"/services/software-engineering\" title=\"Php\"><div class=\"icon-main\">\n<span class=\"flaticon-php\"></span>\n</div>\n</a>\n<a class=\"tech-box\" href=\"/services/software-engineering\" title=\"Electron\"><div class=\"icon-main\">\n<span class=\"flaticon-electron\"></span>\n</div>\n</a>\n<a class=\"tech-box\" href=\"/services/software-engineering\" title=\"Java\"><div class=\"icon-main\">\n<span class=\"flaticon-java\"></span>\n</div>\n</a>\n<a class=\"tech-box\" href=\"/services/performance-seo\" title=\"Css\"><div class=\"icon-main\">\n<span class=\"flaticon-css\"></span>\n</div>\n</a>\n</div>\n<h5>Full-Stack Software Engineering Services</h5>\n<p>\n                    AJNETWORKS delivers end-to-end technology solutions from\n                    strategy to execution. We specialize in custom software\n                    development, cloud-native architecture, cybersecurity,\n                    networking infrastructure, and performance optimization. Our\n                    team combines deep technical expertise with business acumen\n                    to drive real results.\n                  </p>\n<div class=\"ot-button\">\n<a class=\"btn-details\" href=\"/services\" title=\"Right Arrow 1\"><i class=\"flaticon-right-arrow-1\"></i> LEARN MORE</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"about-team\">\n<div class=\"container\">\n<div class=\"row\">\n<di